# ─── Supabase ────────────────────────────────────────────────────────────────
# Your Supabase project URL (found in Project Settings → API)
VITE_SUPABASE_URL=

# Supabase anon/public key — safe to expose client-side (starts with eyJ...)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase project reference ID
VITE_SUPABASE_PROJECT_ID=

# ─── Groq AI ─────────────────────────────────────────────────────────────────
# Server-side Groq API key — NEVER prefix with VITE_
# Get from: console.groq.com
GROQ_API_KEY=

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Stripe publishable key (starts with pk_...) — used client-side
VITE_STRIPE_PUBLISHABLE_KEY=

# Stripe secret key (starts with sk_...) — server-side only, NEVER prefix with VITE_
STRIPE_SECRET_KEY=

# Stripe webhook signing secret (starts with whsec_...) — server-side only
STRIPE_WEBHOOK_SECRET=

# Stripe price IDs for each plan (find in Stripe Dashboard → Products)
# Server-side only — NEVER prefix with VITE_
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_PRO=

# ─── Supabase Service Role (Admin) ──────────────────────────────────────────
# Service role key — FULL ACCESS to your database. NEVER prefix with VITE_
# Only used in serverless functions (webhooks, admin operations)
SUPABASE_SERVICE_ROLE_KEY=

# ─── App URL ─────────────────────────────────────────────────────────────────
# Your app's URL (for Stripe redirects and callback URLs)
VITE_APP_URL=http://localhost:8080

# ─── Cron / Internal Secrets ────────────────────────────────────────────────
# Used to authenticate internal API calls (keep-alive, between serverless functions)
CRON_SECRET=
